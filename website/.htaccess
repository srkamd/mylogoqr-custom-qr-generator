# ==============================================================================
# MyLogoQR Hostinger Apache / LiteSpeed Production Configuration (.htaccess)
# ==============================================================================

# ----------------------------------------------------------------------
# 1. Core Web Vitals & Speed Optimization
# ----------------------------------------------------------------------

# 1a. Enable GZIP & Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml image/svg+xml
</IfModule>

# 1b. Leverage Browser Caching (Zero cache for HTML, 1 Year for Static Assets)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xhtml+xml "access plus 0 seconds"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# 1c. Cache-Control Headers (Fixes 30-day stale HTML issue)
<IfModule mod_headers.c>
  # HTML pages: always revalidate so Googlebot & visitors see real-time updates
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Static assets: cache for 1 year
  <FilesMatch "\.(ico|jpe?g|png|gif|svg|webp|css|js|woff2)$">
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>

  # Security & Privacy Headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# ----------------------------------------------------------------------
# 2. Canonicalization, HTTPS & Clean URL Routing
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 2a. Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2b. Force non-www canonical host (Consolidates www & non-www for Google Search)
  RewriteCond %{HTTP_HOST} ^www\.mylogoqr\.com$ [NC]
  RewriteRule ^(.*)$ https://mylogoqr.com/$1 [L,R=301]

  # 2c. Strip trailing slashes from non-directories for SEO canonical consistency
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} (.+)/$
  RewriteRule ^ %1 [L,R=301]

    # 2d. Redirect explicit .html URLs to clean URLs (prevents duplicate content)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^/]+)\.html\ HTTP/
  RewriteRule ^([^/]+)\.html$ https://mylogoqr.com/$1 [R=301,L]

  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /blog/([^/]+)\.html\ HTTP/
  RewriteRule ^blog/([^/]+)\.html$ https://mylogoqr.com/blog/$1 [R=301,L]

  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([a-z]{2})/([^/]+)\.html\ HTTP/
  RewriteRule ^([a-z]{2})/([^/]+)\.html$ https://mylogoqr.com/$1/$2 [R=301,L]

  # 2e. Internal rewrite: serve clean URLs from physical .html files
  # Language subfolders (es, it, pt, ru, de, fr)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1/$2.html -f
  RewriteRule ^([a-z]{2})/([^/]+)/?$ $1/$2.html [L]

  # Blog subfolder
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/blog/$1.html -f
  RewriteRule ^blog/([^/]+)/?$ blog/$1.html [L]

  # Root pages
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^/]+)/?$ $1.html [L]
</IfModule>

# ----------------------------------------------------------------------
# 3. Custom Error Documents
# ----------------------------------------------------------------------
ErrorDocument 404 /404.html
