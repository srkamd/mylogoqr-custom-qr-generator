# ==============================================================================
# MyLogoQR Hostinger Apache / LiteSpeed Production Configuration (.htaccess)
# ==============================================================================

# ----------------------------------------------------------------------
# 1. Core Web Vitals, Speed Optimization & AI Headers
# ----------------------------------------------------------------------

# 1a. Enable GZIP & Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml image/svg+xml text/markdown
</IfModule>

# 1b. MIME Types
<IfModule mod_mime.c>
  AddType text/markdown .md
  AddType application/json .json
</IfModule>

# 1c. Leverage Browser Caching (Zero cache for HTML, 1 Year for Static Assets)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xhtml+xml "access plus 0 seconds"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# 1d. Headers (Security, Cache-Control & AI Agent Discovery)
<IfModule mod_headers.c>
  # HTML pages: optimize for fast TTFB (<200ms) with LiteSpeed & edge caching while ensuring timely updates
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=300, stale-while-revalidate=86400"
  </FilesMatch>

  # Static assets: cache for 1 year
  <FilesMatch "\.(ico|jpe?g|png|gif|svg|webp|css|js|woff2|woff|ttf)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  # Security & Privacy Headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # AI Agent Visibility & Discovery (Hostinger / aivisibilityfactors.com Standard)
  Header always set Content-Signal "search=yes, ai-input=yes, ai-train=yes"
  Header always set Link "</llms.txt>; rel=\"describedby\"; type=\"text/plain\", </llms-full.txt>; rel=\"describedby\"; type=\"text/plain\", </sitemap.xml>; rel=\"sitemap\"; type=\"application/xml\", </.well-known/mcp/server-card.json>; rel=\"service-desc\"; type=\"application/json\", </.well-known/mcp.json>; rel=\"service-desc\"; type=\"application/json\""

  # Open CORS for Machine-Readable AI & Discovery Endpoints
  <FilesMatch "\.(json|txt|xml|md)$">
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, OPTIONS"
  </FilesMatch>
</IfModule>

# ----------------------------------------------------------------------
# 2. Canonicalization, HTTPS, AI Content Negotiation & Clean URLs
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Whitelist SEO Audit bots & prevent LiteSpeed rate-limiting / throttling (HTTP 429)
  RewriteCond %{HTTP_USER_AGENT} (OpenSEO-Audit|AhrefsBot|SemrushBot|DotBot|OpenSEO) [NC]
  RewriteRule .* - [E=nothrottle:1,E=noabort:1]

  # Normalize sitemap and robots case-insensitively (e.g. SITEMAP.XML -> sitemap.xml)
  RewriteRule ^sitemap\.xml$ sitemap.xml [NC,L]
  RewriteRule ^robots\.txt$ robots.txt [NC,L]

  # 301 Redirect old / malformed crawler URLs to 200 OK endpoints
  RewriteRule ^,'?(viewBox|height)=.*$ / [R=301,L]
  RewriteRule ^blog/ethics-and-dangers-of-deepfakes-ai-voice-cloning/?$ /blog/ [R=301,L]
  RewriteBase /

  # 2a. Single-Hop Canonical Redirect (Combines HTTPS + non-www into 1 hop, eliminates redirect chains)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\.mylogoqr\.com$ [NC]
  RewriteRule ^(.*)$ https://mylogoqr.com/$1 [L,R=301]

  # 2c. Strip trailing slashes from non-directories for SEO canonical consistency
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} (.+)/$
  RewriteRule ^ %1 [L,R=301]

  # 2d. Agent-Native Content Negotiation: Serves Markdown when an agent asks for it via Accept header
  RewriteCond %{HTTP:Accept} text/(markdown|x-markdown) [NC]
  RewriteCond %{REQUEST_URI} ^/?$ [OR]
  RewriteCond %{REQUEST_URI} ^/index(\.html)?$
  RewriteRule .* /llms.txt [T=text/markdown,L]

  # 2e. Redirect explicit .html URLs to clean URLs (prevents duplicate content)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^/]+)\.html\ HTTP/
  RewriteRule ^([^/]+)\.html$ https://mylogoqr.com/$1 [R=301,L]

  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /blog/([^/]+)\.html\ HTTP/
  RewriteRule ^blog/([^/]+)\.html$ https://mylogoqr.com/blog/$1 [R=301,L]

  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /tools/([^/]+)\.html\ HTTP/
  RewriteRule ^tools/([^/]+)\.html$ https://mylogoqr.com/tools/$1 [R=301,L]

  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([a-z]{2})/blog/([^/]+)\.html\ HTTP/
  RewriteRule ^([a-z]{2})/blog/([^/]+)\.html$ https://mylogoqr.com/$1/blog/$2 [R=301,L]

  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([a-z]{2})/([^/]+)\.html\ HTTP/
  RewriteRule ^([a-z]{2})/([^/]+)\.html$ https://mylogoqr.com/$1/$2 [R=301,L]

  # 2f. Internal rewrite: serve clean URLs from physical .html files
  # Universal rule: if request + .html exists as a file, serve it directly (handles any folder depth)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # Fallback mappings using DOCUMENT_ROOT
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1/blog/$2.html -f
  RewriteRule ^([a-z]{2})/blog/([^/]+)/?$ $1/blog/$2.html [L]

  # Language subfolders (es, it, pt, ru, de, fr)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1/$2.html -f
  RewriteRule ^([a-z]{2})/([^/]+)/?$ $1/$2.html [L]

  # Tools subfolder
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/tools/$1.html -f
  RewriteRule ^tools/([^/]+)/?$ tools/$1.html [L]

  # Blog subfolder
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/blog/$1.html -f
  RewriteRule ^blog/([^/]+)/?$ blog/$1.html [L]

  # Root pages
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^/]+)/?$ $1.html [L]
</IfModule>

# ----------------------------------------------------------------------
# 3. Custom Error Documents
# ----------------------------------------------------------------------
ErrorDocument 404 /404.html
