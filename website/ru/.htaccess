# ----------------------------------------------------------------------
# Clean URL Rewriting for /ru/ Language Tools on LiteSpeed / Apache
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /ru/

  # Redirect explicit .html requests to clean URLs
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /ru/([^/]+)\.html\ HTTP/
  RewriteRule ^([^/]+)\.html$ https://mylogoqr.com/ru/$1 [R=301,L]

  # Internal rewrite: serve clean URL from physical .html file
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^([^/]+)/?$ $1.html [L]
</IfModule>
