RewriteEngine On
RewriteBase /

# Prevent rewrite loop (Apache internal recursion limit AH00124)
RewriteCond %{ENV:REDIRECT_STATUS} 200
RewriteRule ^ - [L]

# Force HTTPS (SSL) Redirect
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Redirect external requests from /page.html to clean /page (SEO canonicalization)
RewriteCond %{THE_REQUEST} \s/(.+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Redirect external /index to root /
RewriteCond %{THE_REQUEST} \s/index[\s?] [NC]
RewriteRule ^ / [R=301,L]

# Redirect legacy url-qr-code-generator to root (/)
RewriteRule ^url-qr-code-generator/?$ / [R=301,L,NC]

# Clean URL for blog hub (/blog or /blog/) -> /blog.html
RewriteRule ^blog/?$ /blog.html [L,NC]

# Clean URL for blog articles (/blog/article-slug -> /blog/article-slug.html)
# [^/.]+ ensures we never match files already ending in .html
RewriteRule ^blog/([^/.]+)/?$ /blog/$1.html [L,NC]

# Clean URL for root tools and pages (/page -> /page.html)
RewriteRule ^([^/.]+)/?$ /$1.html [L,NC]

# Security Headers Configuration
<IfModule mod_headers.c>
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>
